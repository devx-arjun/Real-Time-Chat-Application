generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String                    @id @default(cuid())
  username           String
  bio                String?
  avatarUrl          String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  guestId            String                    @unique
  usernameNormalized String                    @unique
  conversations      ConversationParticipant[]
  ownedConversations Conversation[]            @relation("ConversationOwner")
  messages           Message[]
  reactions          MessageReaction[]
  spaceMemberships   SpaceMember[]
}

model Space {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  description   String?
  imageUrl      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  members       SpaceMember[]

  @@index([createdAt])
}

model SpaceMember {
  id       String    @id @default(cuid())
  role     SpaceRole @default(MEMBER)
  joinedAt DateTime  @default(now())
  userId   String
  spaceId  String
  space    Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
  @@index([userId])
  @@index([spaceId])
}

model Conversation {
  id        String   @id @default(cuid())
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  spaceId   String?
  isPrivate Boolean  @default(false)
  joinCode  String?  @unique

  ownerId String
  owner   User   @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  space        Space?                    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([spaceId, createdAt])
  @@index([ownerId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  joinedAt       DateTime     @default(now())
  userId         String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             String            @id @default(cuid())
  content        String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  senderId       String
  conversationId String
  replyToId      String?
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo        Message?          @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        Message[]         @relation("MessageReplies")
  sender         User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions      MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model MessageReaction {
  id        String   @id @default(cuid())
  emoji     String
  createdAt DateTime @default(now())
  userId    String
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([messageId])
}

enum SpaceRole {
  OWNER
  MODERATOR
  MEMBER
}
